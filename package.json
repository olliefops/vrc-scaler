{
  "name": "vrc-scaler",
  "version": "1.0.0-beta2",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun run build:win && bun run build:linux-x64 && bun run build:linux-arm",
    "build:win": "bun build --compile --target bun-win32-x64 src/index.ts --outfile=./dist/vrc-scaler_v$(node -p \"require('./package.json').version\")",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 src/index.ts --outfile=./dist/vrc-scaler_v$(node -p \"require('./package.json').version\")_x64",
    "build:linux-arm": "bun build --compile --target=bun-linux-arm64 src/index.ts --outfile=./dist/vrc-scaler_v$(node -p \"require('./package.json').version\")_arm64"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "node-osc": "^11.7.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3"
  },
  "private": true
}
